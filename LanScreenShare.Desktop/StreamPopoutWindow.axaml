<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LanScreenShare.Desktop.StreamPopoutWindow"
        Title="Visor Remoto - LanScreenShare"
        Background="#09090B"
        Width="1024"
        Height="600"
        MinWidth="400"
        MinHeight="300"
        WindowStartupLocation="CenterScreen">

    <Grid x:Name="PopoutRootGrid">
        <!-- Video Viewport -->
        <Image x:Name="ScreenImage"
               Stretch="Uniform"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               Focusable="True"
               DragDrop.AllowDrop="True"
               RenderOptions.BitmapInterpolationMode="HighQuality"/>

        <!-- Auto-hiding Top Header Overlay -->
        <Border x:Name="StreamHeaderBar"
                VerticalAlignment="Top"
                Background="#F218181B"
                BorderBrush="#2D2D35"
                BorderThickness="0,0,0,1"
                Padding="16,10"
                ZIndex="100">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusIndicator" Width="10" Height="10" Fill="#22C55E"/>
                    <TextBlock x:Name="StatusText"
                               Text="Recibiendo pantalla"
                               Foreground="#E4E4E7"
                               FontSize="13"
                               FontWeight="Medium"
                               VerticalAlignment="Center"/>
                    <Border x:Name="StatsBadge"
                            Background="#27272A"
                            BorderBrush="#3F3F46"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,2"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse x:Name="StatsQualityDot" Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatsText"
                                       Text="0 FPS • 0 KB/s"
                                       Foreground="#38BDF8"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <!-- Modo de Ajuste (Fit / Stretch) -->
                    <Button x:Name="StretchModeButton"
                            Background="#27272A"
                            Foreground="White"
                            Padding="10,6"
                            CornerRadius="4"
                            ToolTip.Tip="Alternar modo de ajuste: Ajustar aspecto (Fit) / Llenar pantalla (Stretch)">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconAspectRatio}" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StretchModeButtonText" Text="Ajustar" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Adaptar tamaño de ventana al video -->
                    <Button x:Name="AutoFitButton"
                            Background="#27272A"
                            Foreground="White"
                            Padding="10,6"
                            CornerRadius="4"
                            ToolTip.Tip="Adaptar tamaño de ventana a la proporción del anfitrión">
                        <TextBlock Text="1:1 Proporción" FontSize="12" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Pantalla Completa -->
                    <Button x:Name="FullscreenButton"
                            Background="#27272A"
                            Foreground="White"
                            Padding="10,6"
                            CornerRadius="4"
                            ToolTip.Tip="Alternar Pantalla Completa (F11 / Doble Clic)">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon x:Name="FullscreenButtonIcon" Data="{StaticResource IconFullscreen}" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock x:Name="FullscreenButtonText" Text="Pantalla Completa" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Reacoplar a ventana principal -->
                    <Button x:Name="ReattachButton"
                            Background="#2563EB"
                            Foreground="White"
                            Padding="10,6"
                            CornerRadius="4"
                            ToolTip.Tip="Volver a acoplar el visor a la ventana principal">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconDock}" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="Reacoplar" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Desconectar -->
                    <Button x:Name="DisconnectButton"
                            Content="Desconectar"
                            Background="#DC2626"
                            Foreground="White"
                            Padding="12,6"
                            CornerRadius="4"
                            FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Auto-hiding Bottom Footer Overlay -->
        <Border x:Name="StreamFooterBar"
                VerticalAlignment="Bottom"
                Background="#F218181B"
                BorderBrush="#2D2D35"
                BorderThickness="0,1,0,0"
                Padding="16,8"
                ZIndex="100">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <!-- Audio and Mic volume & mute controls -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Control de Audio (Silenciar y Control de Volumen) -->
                    <Border x:Name="AudioControlPanel"
                            Background="#27272A"
                            CornerRadius="4"
                            Padding="4,2">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button x:Name="AudioMuteButton"
                                    Background="Transparent"
                                    Foreground="White"
                                    Padding="4"
                                    BorderThickness="0"
                                    ToolTip.Tip="Silenciar / Activar audio">
                                <PathIcon x:Name="AudioMuteIcon" Data="{StaticResource IconVolumeUp}" Width="14" Height="14" Foreground="White"/>
                            </Button>
                            <Slider x:Name="AudioVolumeSlider"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="100"
                                    Width="65"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="Volumen de transmisión"/>
                            <TextBlock x:Name="AudioVolumeText"
                                       Text="100%"
                                       FontSize="11"
                                       Foreground="#A1A1AA"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Control de Micrófono (Silenciar y Control de Volumen) -->
                    <Border x:Name="MicControlPanel"
                            Background="#27272A"
                            CornerRadius="4"
                            Padding="4,2">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button x:Name="MicMuteButton"
                                    Background="Transparent"
                                    Foreground="White"
                                    Padding="4"
                                    BorderThickness="0"
                                    ToolTip.Tip="Silenciar / Activar micrófono del anfitrión">
                                <PathIcon x:Name="MicMuteIcon" Data="{StaticResource IconMic}" Width="14" Height="14" Foreground="#10B981"/>
                            </Button>
                            <Slider x:Name="MicVolumeSlider"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="100"
                                    Width="65"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="Volumen de micrófono del anfitrión"/>
                            <TextBlock x:Name="MicVolumeText"
                                       Text="100%"
                                       FontSize="11"
                                       Foreground="#A1A1AA"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Operation controls: Remote Control, 3D Mode, Switch Monitor, Send File -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Control Remoto -->
                    <ToggleButton x:Name="RemoteControlButton"
                                  Background="#27272A"
                                  Foreground="White"
                                  Padding="10,6"
                                  CornerRadius="4"
                                  ToolTip.Tip="Habilitar interacción con mouse y teclado">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconGamepad}" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="Control" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- Modo 3D -->
                    <ToggleButton x:Name="GameModeButton"
                                  Background="#27272A"
                                  Foreground="White"
                                  Padding="10,6"
                                  CornerRadius="4"
                                  ToolTip.Tip="Captura el mouse para juegos 3D (giro 360°). Presiona Ctrl+Alt+L para liberar el cursor">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource Icon3dRotation}" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="Modo 3D (Ctrl+Alt+L)" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- Cambiar Monitor Remoto -->
                    <Button x:Name="SwitchMonitorButton"
                            Background="#27272A"
                            Foreground="White"
                            Padding="10,6"
                            CornerRadius="4"
                            ToolTip.Tip="Elegir o cambiar pantalla/ventana del anfitrión (Ctrl+Alt+M)">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconAllScreens}" Width="14" Height="14" Foreground="#38BDF8" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SwitchMonitorButtonText" Text="Pantalla" FontSize="12" VerticalAlignment="Center"/>
                            <PathIcon Data="{StaticResource IconChevronDown}" Width="10" Height="10" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="2,1,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Enviar Archivo -->
                    <Button x:Name="SendFileButton"
                            Background="#27272A"
                            Foreground="White"
                            Padding="10,6"
                            CornerRadius="4"
                            ToolTip.Tip="Enviar archivo al anfitrión (o arrastra y suelta aquí)">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconSendFile}" Width="14" Height="14" Foreground="#10B981" VerticalAlignment="Center"/>
                            <TextBlock Text="Enviar archivo" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Banner Modo 3D / Mouse Liberado -->
        <Border x:Name="GameModeBanner"
                Background="#E618181B"
                BorderBrush="#38BDF8"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,60,0,0"
                IsVisible="False"
                ZIndex="110">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <PathIcon x:Name="GameModeBannerIcon" Data="{StaticResource Icon3dRotation}" Width="18" Height="18" Foreground="#38BDF8"/>
                <TextBlock x:Name="GameModeBannerText"
                           Text="Modo 3D Activo — Presiona Ctrl + Alt + L para liberar el cursor"
                           Foreground="#38BDF8"
                           FontSize="13"
                           FontWeight="Medium"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

