<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LanScreenShare.Desktop.StreamPopoutWindow"
        Title="Visor Remoto - LanScreenShare"
        Background="#09090B"
        Width="1024"
        Height="600"
        MinWidth="400"
        MinHeight="300"
        WindowStartupLocation="CenterScreen">

    <Grid x:Name="PopoutRootGrid">
        <!-- Video Viewport -->
        <Image x:Name="ScreenImage"
               Stretch="Uniform"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               Focusable="True"
               RenderOptions.BitmapInterpolationMode="HighQuality"/>

        <!-- Auto-hiding Top Header Overlay -->
        <Border x:Name="StreamHeaderBar"
                VerticalAlignment="Top"
                Background="#F218181B"
                BorderBrush="#2D2D35"
                BorderThickness="0,0,0,1"
                Padding="16,10"
                ZIndex="100">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusIndicator" Width="10" Height="10" Fill="#22C55E"/>
                    <TextBlock x:Name="StatusText"
                               Text="Recibiendo pantalla"
                               Foreground="#E4E4E7"
                               FontSize="13"
                               FontWeight="Medium"
                               VerticalAlignment="Center"/>
                    <Border x:Name="StatsBadge"
                            Background="#27272A"
                            BorderBrush="#3F3F46"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,2"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="StatsText"
                                   Text="0 FPS • 0 KB/s"
                                   Foreground="#38BDF8"
                                   FontSize="11"
                                   FontWeight="Medium"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <!-- Control Remoto -->
                    <ToggleButton x:Name="RemoteControlButton"
                                  Background="#27272A"
                                  Foreground="White"
                                  Padding="10,6"
                                  CornerRadius="4"
                                  ToolTip.Tip="Habilitar interacción con mouse y teclado">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconGamepad}" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="Control" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- Modo 3D -->
                    <ToggleButton x:Name="GameModeButton"
                                  Background="#27272A"
                                  Foreground="White"
                                  Padding="10,6"
                                  CornerRadius="4"
                                  ToolTip.Tip="Captura el mouse para juegos 3D (giro 360°). Presiona Ctrl+Alt+L para liberar el cursor">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource Icon3dRotation}" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="Modo 3D (Ctrl+Alt+L)" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- Silenciar / Activar audio -->
                    <Button x:Name="AudioMuteButton"
                            Background="#27272A"
                            Foreground="White"
                            Padding="8,6"
                            CornerRadius="4"
                            ToolTip.Tip="Silenciar / Activar audio">
                        <PathIcon x:Name="AudioMuteIcon" Data="{StaticResource IconVolumeUp}" Width="14" Height="14" Foreground="White"/>
                    </Button>

                    <!-- Modo de Ajuste (Fit / Stretch) -->
                    <Button x:Name="StretchModeButton"
                            Background="#27272A"
                            Foreground="White"
                            Padding="10,6"
                            CornerRadius="4"
                            ToolTip.Tip="Alternar modo de ajuste: Ajustar aspecto (Fit) / Llenar pantalla (Stretch)">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconAspectRatio}" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StretchModeButtonText" Text="Ajustar" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Adaptar tamaño de ventana al video -->
                    <Button x:Name="AutoFitButton"
                            Background="#27272A"
                            Foreground="White"
                            Padding="10,6"
                            CornerRadius="4"
                            ToolTip.Tip="Adaptar tamaño de ventana a la proporción del anfitrión">
                        <TextBlock Text="1:1 Proporción" FontSize="12" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Pantalla Completa -->
                    <Button x:Name="FullscreenButton"
                            Background="#27272A"
                            Foreground="White"
                            Padding="10,6"
                            CornerRadius="4"
                            ToolTip.Tip="Alternar Pantalla Completa (F11 / Doble Clic)">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon x:Name="FullscreenButtonIcon" Data="{StaticResource IconFullscreen}" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock x:Name="FullscreenButtonText" Text="Pantalla Completa" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Reacoplar a ventana principal -->
                    <Button x:Name="ReattachButton"
                            Background="#2563EB"
                            Foreground="White"
                            Padding="10,6"
                            CornerRadius="4"
                            ToolTip.Tip="Volver a acoplar el visor a la ventana principal">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconDock}" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="Reacoplar" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Desconectar -->
                    <Button x:Name="DisconnectButton"
                            Content="Desconectar"
                            Background="#DC2626"
                            Foreground="White"
                            Padding="12,6"
                            CornerRadius="4"
                            FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Banner Modo 3D / Mouse Liberado -->
        <Border x:Name="GameModeBanner"
                Background="#E618181B"
                BorderBrush="#38BDF8"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,60,0,0"
                IsVisible="False"
                ZIndex="110">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <PathIcon x:Name="GameModeBannerIcon" Data="{StaticResource Icon3dRotation}" Width="18" Height="18" Foreground="#38BDF8"/>
                <TextBlock x:Name="GameModeBannerText"
                           Text="Modo 3D Activo — Presiona Ctrl + Alt + L para liberar el cursor"
                           Foreground="#38BDF8"
                           FontSize="13"
                           FontWeight="Medium"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
