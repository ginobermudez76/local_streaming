<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:LanScreenShare.Core.Models"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="580"
        x:Class="LanScreenShare.Desktop.SourcePickerWindow"
        Title="Elige qué compartir"
        Width="640" Height="580"
        CanResize="False"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0,0,0,10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Default Unselected Card -->
        <Style Selector="ListBoxItem Border.sourceCard">
            <Setter Property="Background" Value="#171E2B"/>
            <Setter Property="BorderBrush" Value="#253042"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover Border.sourceCard">
            <Setter Property="Background" Value="#1B2434"/>
            <Setter Property="BorderBrush" Value="#314159"/>
        </Style>

        <!-- Selected Card -->
        <Style Selector="ListBoxItem:selected Border.sourceCard">
            <Setter Property="Background" Value="#182844"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>

        <!-- Icon Box inside Card -->
        <Style Selector="ListBoxItem Border.sourceIconBox">
            <Setter Property="Background" Value="#202938"/>
            <Setter Property="BorderBrush" Value="#2C384C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
        </Style>
        <Style Selector="ListBoxItem:selected Border.sourceIconBox">
            <Setter Property="Background" Value="#213559"/>
            <Setter Property="BorderBrush" Value="#314E80"/>
        </Style>

        <!-- Radio Indicator inside Card -->
        <Style Selector="ListBoxItem Border.radioUnselected">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="ListBoxItem:selected Border.radioUnselected">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ListBoxItem Border.radioSelected">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ListBoxItem:selected Border.radioSelected">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
    </Window.Styles>

    <Border Background="#121822"
            BorderBrush="#222C3C"
            BorderThickness="1"
            CornerRadius="16"
            ClipToBounds="True">
        <Grid RowDefinitions="*,Auto">
            <!-- ========================================================= -->
            <!-- MAIN CONTENT AREA                                         -->
            <!-- ========================================================= -->
            <Grid Grid.Row="0" RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="24,22,24,14">

                <!-- ROW 0: Header with Icon, Title/Subtitle & Close Button -->
                <Grid x:Name="HeaderDragGrid"
                      Grid.Row="0"
                      ColumnDefinitions="Auto,*,Auto"
                      Background="Transparent">
                    <Border Grid.Column="0"
                            Width="40" Height="40"
                            CornerRadius="10"
                            Background="#1C2B45"
                            BorderBrush="#293F63"
                            BorderThickness="1"
                            VerticalAlignment="Top"
                            Margin="0,2,14,0">
                        <PathIcon Data="{StaticResource IconTv}"
                                  Width="18" Height="18"
                                  Foreground="#60A5FA"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="Elige qué compartir"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#F8FAFC"/>
                        <TextBlock Text="Comparte una pantalla completa o solo una aplicación."
                                   FontSize="13"
                                   Foreground="#7C8B9E"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            x:Name="CloseButton"
                            Width="36" Height="36"
                            CornerRadius="9"
                            Background="#19212E"
                            BorderBrush="#253042"
                            BorderThickness="1"
                            Padding="0"
                            VerticalAlignment="Top"
                            Cursor="Hand">
                        <PathIcon Data="{StaticResource IconClose}"
                                  Width="13" Height="13"
                                  Foreground="#CBD5E1"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <!-- ROW 1: Segmented Tab Bar (Pantallas / Ventanas y aplicaciones) -->
                <Border Grid.Row="1"
                        Background="#141A24"
                        BorderBrush="#232E40"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="4"
                        Margin="0,18,0,14">
                    <Grid ColumnDefinitions="*,*">
                        <Button x:Name="ScreensTabButton"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Background="#1E3252"
                                BorderThickness="0"
                                CornerRadius="7"
                                Padding="12,9"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <PathIcon x:Name="ScreensTabIcon"
                                          Data="{StaticResource IconTv}"
                                          Width="15" Height="15"
                                          Foreground="#60A5FA"
                                          VerticalAlignment="Center"/>
                                <TextBlock x:Name="ScreensTabText"
                                           Text="Pantallas"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#F8FAFC"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="WindowsTabButton"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="7"
                                Padding="12,9"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <PathIcon x:Name="WindowsTabIcon"
                                          Data="{StaticResource IconWindow}"
                                          Width="15" Height="15"
                                          Foreground="#8B9BB0"
                                          VerticalAlignment="Center"/>
                                <TextBlock x:Name="WindowsTabText"
                                           Text="Ventanas y aplicaciones"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#8B9BB0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- ROW 2: Count & Refresh Button Row -->
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="2,0,2,10" MinHeight="28">
                    <TextBlock Grid.Column="0"
                               x:Name="SourceCountText"
                               Text="3 fuentes disponibles"
                               FontSize="12"
                               Foreground="#8B9BB0"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            x:Name="RefreshWindowsButton"
                            IsVisible="False"
                            Background="#171E2B"
                            BorderBrush="#263246"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="12,5"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconRefresh}"
                                      Width="12" Height="12"
                                      Foreground="#CBD5E1"
                                      VerticalAlignment="Center"/>
                            <TextBlock Text="Actualizar lista"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="#E2E8F0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ROW 3: Sources Lists (Pantallas / Ventanas) -->
                <Grid Grid.Row="3">
                    <!-- PANTALLAS LIST -->
                    <ScrollViewer x:Name="ScreensScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ListBox x:Name="ScreensListBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 SelectionMode="Single">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:CaptureSource">
                                    <Border Classes="sourceCard">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
                                            <!-- Icon Box -->
                                            <Border Grid.Column="0"
                                                    Classes="sourceIconBox"
                                                    Margin="0,0,14,0">
                                                <Panel>
                                                    <PathIcon Data="{StaticResource IconAllScreens}"
                                                              IsVisible="{Binding IsAllScreens}"
                                                              Width="19" Height="19"
                                                              Foreground="#CBD5E1"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                                    <PathIcon Data="{StaticResource IconTv}"
                                                              IsVisible="{Binding IsSingleScreen}"
                                                              Width="19" Height="19"
                                                              Foreground="#CBD5E1"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                                </Panel>
                                            </Border>

                                            <!-- Title & Subtitle -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="14.5"
                                                           FontWeight="Bold"
                                                           Foreground="#F8FAFC"/>
                                                <TextBlock Text="{Binding Subtitle}"
                                                           FontSize="12"
                                                           Foreground="#8B9BB0"/>
                                            </StackPanel>

                                            <!-- "Principal" Badge -->
                                            <Border Grid.Column="2"
                                                    IsVisible="{Binding IsPrimary}"
                                                    Background="#213559"
                                                    BorderBrush="#2E4775"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="14,4"
                                                    Margin="12,0,18,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="Principal"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#DBEAFE"/>
                                            </Border>

                                            <!-- Selection Radio / Checkmark -->
                                            <Panel Grid.Column="3" VerticalAlignment="Center">
                                                <Border Classes="radioUnselected"
                                                        Width="22" Height="22"
                                                        CornerRadius="11"
                                                        Background="Transparent"
                                                        BorderBrush="#475569"
                                                        BorderThickness="1.5"/>
                                                <Border Classes="radioSelected"
                                                        Width="22" Height="22"
                                                        CornerRadius="11"
                                                        Background="#3B82F6">
                                                    <PathIcon Data="{StaticResource IconCheck}"
                                                              Width="11" Height="11"
                                                              Foreground="White"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                                </Border>
                                            </Panel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                    <!-- VENTANAS Y APLICACIONES LIST -->
                    <ScrollViewer x:Name="WindowsScrollViewer"
                                  IsVisible="False"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ListBox x:Name="WindowsListBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 SelectionMode="Single">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:CaptureSource">
                                    <Border Classes="sourceCard">
                                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                            <!-- Icon Box -->
                                            <Border Grid.Column="0"
                                                    Classes="sourceIconBox"
                                                    Margin="0,0,14,0">
                                                <PathIcon Data="{StaticResource IconWindow}"
                                                          Width="19" Height="19"
                                                          Foreground="#CBD5E1"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Window Title & Process/Dimensions -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3" Margin="0,0,14,0">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="14.5"
                                                           FontWeight="Bold"
                                                           Foreground="#F8FAFC"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Subtitle}"
                                                           FontSize="12"
                                                           Foreground="#8B9BB0"/>
                                            </StackPanel>

                                            <!-- Selection Radio / Checkmark -->
                                            <Panel Grid.Column="2" VerticalAlignment="Center">
                                                <Border Classes="radioUnselected"
                                                        Width="22" Height="22"
                                                        CornerRadius="11"
                                                        Background="Transparent"
                                                        BorderBrush="#475569"
                                                        BorderThickness="1.5"/>
                                                <Border Classes="radioSelected"
                                                        Width="22" Height="22"
                                                        CornerRadius="11"
                                                        Background="#3B82F6">
                                                    <PathIcon Data="{StaticResource IconCheck}"
                                                              Width="11" Height="11"
                                                              Foreground="White"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                                </Border>
                                            </Panel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Grid>

                <!-- ROW 4: Privacy Note -->
                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            Spacing="8"
                            Margin="2,10,0,2"
                            VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource IconLockClosed}"
                              Width="13" Height="13"
                              Foreground="#7C8B9E"
                              VerticalAlignment="Center"/>
                    <TextBlock Text="Solo se compartirá la fuente seleccionada."
                               FontSize="12"
                               Foreground="#7C8B9E"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- ========================================================= -->
            <!-- BOTTOM FOOTER BAR                                         -->
            <!-- ========================================================= -->
            <Border Grid.Row="1"
                    Background="#10151E"
                    BorderBrush="#1E2633"
                    BorderThickness="0,1,0,0"
                    Padding="24,16">
                <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="SELECCIONADO"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#6E7E94"
                                   LetterSpacing="0.8"/>
                        <TextBlock x:Name="SelectedSourceInfoText"
                                   Text="Pantalla 1 · Principal"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="#E2E8F0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            x:Name="CancelButton"
                            Content="Cancelar"
                            Background="#171E2B"
                            Foreground="#E2E8F0"
                            BorderBrush="#283449"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20,10"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Margin="0,0,10,0"
                            Cursor="Hand"/>

                    <Button Grid.Column="2"
                            x:Name="SelectButton"
                            Background="#3B82F6"
                            Foreground="White"
                            CornerRadius="8"
                            Padding="18,10"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconCheck}"
                                      Width="13" Height="13"
                                      Foreground="White"
                                      VerticalAlignment="Center"/>
                            <TextBlock Text="Seleccionar fuente"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
