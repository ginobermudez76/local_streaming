<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:LanScreenShare.Core.Models"
        mc:Ignorable="d" d:DesignWidth="1050" d:DesignHeight="650"
        x:Class="LanScreenShare.Desktop.MainWindow"
        Title="LanScreenShare - Streaming LAN"
        Width="1050" Height="650"
        MinWidth="800" MinHeight="500"
        Background="#18181B">

    <Grid ColumnDefinitions="310,*">
        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#1F1F23" BorderBrush="#2D2D35" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="16">
                    <!-- App Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,14" Spacing="4">
                    <TextBlock Text="LanScreenShare" FontSize="20" FontWeight="Bold" Foreground="#FAFAFA"/>
                    <TextBlock Text="Transmisión de pantalla en LAN" FontSize="12" Foreground="#A1A1AA"/>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,14">
                    <Button x:Name="HostButton"
                            Content="Transmitir mi pantalla"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="#3B82F6"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Padding="12,10"
                            CornerRadius="6"/>

                    <Button x:Name="SearchButton"
                            Content="Buscar dispositivos"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="#27272A"
                            Foreground="White"
                            Padding="12,10"
                            CornerRadius="6"/>
                </StackPanel>

                <!-- Settings Section -->
                <Border Grid.Row="2"
                        Background="#27272A"
                        BorderBrush="#3F3F46"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Ajustes de Transmisión"
                                   Foreground="#FAFAFA"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>

                        <!-- Engine Selector -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Motor de Captura" FontSize="11" Foreground="#A1A1AA"/>
                            <ComboBox x:Name="EngineComboBox"
                                      HorizontalAlignment="Stretch"
                                      FontSize="12"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="DirectX DXGI (GPU Acelerado)" Tag="dxgi"/>
                                <ComboBoxItem Content="GDI BitBlt (CPU Compatibilidad)" Tag="gdi"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Codec Selector -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Códec de Video" FontSize="11" Foreground="#A1A1AA"/>
                            <ComboBox x:Name="CodecComboBox"
                                      HorizontalAlignment="Stretch"
                                      FontSize="12"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="JPEG (Ultra Baja Latencia / Estable)" Tag="jpeg"/>
                                <ComboBoxItem Content="H.264 / AVC (Aceleración GPU)" Tag="h264"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- FPS Selector -->
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="FPS Objetivo" FontSize="11" Foreground="#A1A1AA"/>
                                <TextBlock Grid.Column="1" x:Name="FpsValueLabel" Text="30 FPS" FontSize="11" Foreground="#38BDF8" FontWeight="Medium"/>
                            </Grid>
                            <ComboBox x:Name="FpsComboBox"
                                      HorizontalAlignment="Stretch"
                                      FontSize="12"
                                      SelectedIndex="1">
                                <ComboBoxItem Content="15 FPS (Bajo consumo)" Tag="15"/>
                                <ComboBoxItem Content="30 FPS (Recomendado)" Tag="30"/>
                                <ComboBoxItem Content="60 FPS (Ultra fluido)" Tag="60"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Quality Slider -->
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Calidad JPEG" FontSize="11" Foreground="#A1A1AA"/>
                                <TextBlock Grid.Column="1" x:Name="QualityValueLabel" Text="75%" FontSize="11" Foreground="#38BDF8" FontWeight="Medium"/>
                            </Grid>
                            <Slider x:Name="QualitySlider"
                                    Minimum="30"
                                    Maximum="95"
                                    Value="75"
                                    SmallChange="5"
                                    LargeChange="10"/>
                        </StackPanel>

                        <!-- Resolution Scale Selector -->
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Resolución" FontSize="11" Foreground="#A1A1AA"/>
                                <TextBlock Grid.Column="1" x:Name="ScaleValueLabel" Text="100%" FontSize="11" Foreground="#38BDF8" FontWeight="Medium"/>
                            </Grid>
                            <ComboBox x:Name="ScaleComboBox"
                                      HorizontalAlignment="Stretch"
                                      FontSize="12"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="100% (Nativa)" Tag="1.0"/>
                                <ComboBoxItem Content="75% (Equilibrado)" Tag="0.75"/>
                                <ComboBoxItem Content="50% (Rápido / Wi-Fi)" Tag="0.5"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Audio Share Toggle -->
                        <CheckBox x:Name="AudioShareCheckBox"
                                  Content="Transmitir audio (WASAPI Loopback)"
                                  IsChecked="True"
                                  Foreground="#E4E4E7"
                                  FontSize="11"
                                  Margin="0,2,0,0"/>

                        <!-- Remote Control Allow Toggle -->
                        <CheckBox x:Name="AllowRemoteControlCheckBox"
                                  Content="Permitir control remoto (Mouse/Teclas)"
                                  IsChecked="True"
                                  Foreground="#E4E4E7"
                                  FontSize="11"
                                  Margin="0,2,0,0"/>

                        <!-- Admin Privilege Warning/Badge -->
                        <Border x:Name="AdminStatusBorder"
                                Background="#27272A"
                                CornerRadius="4"
                                Padding="8,5"
                                Margin="0,4,0,0">
                            <TextBlock x:Name="AdminStatusText"
                                       Text="🛡️ Modo Estándar"
                                       Foreground="#F59E0B"
                                       FontSize="10"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Devices Header -->
                <TextBlock Grid.Row="3"
                           Text="Dispositivos detectados:"
                           Foreground="#A1A1AA"
                           FontSize="12"
                           FontWeight="Medium"
                           Margin="0,0,0,8"/>

                <!-- Devices List -->
                <ListBox Grid.Row="4"
                         x:Name="DevicesList"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:DeviceInfo">
                            <Border Background="#27272A"
                                    BorderBrush="#3F3F46"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="0,0,0,6">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#FAFAFA"/>
                                        <TextBlock Text="{Binding IPAddress}" FontSize="12" Foreground="#71717A"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Ver"
                                            Tag="{Binding}"
                                            Click="ConnectDevice_Click"
                                            Background="#2563EB"
                                            Foreground="White"
                                            FontSize="12"
                                            Padding="10,6"
                                            CornerRadius="4"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Footer / Local Info -->
                <TextBlock Grid.Row="5"
                           x:Name="LocalInfoText"
                           Text="Listo para transmitir o recibir"
                           FontSize="11"
                           Foreground="#71717A"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"/>
            </Grid>
        </ScrollViewer>
    </Border>

        <!-- Main Area (Stream Preview) -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <!-- Stream Header Bar -->
            <Border Grid.Row="0"
                    Background="#1F1F23"
                    BorderBrush="#2D2D35"
                    BorderThickness="0,0,0,1"
                    Padding="16,10">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusIndicator" Width="10" Height="10" Fill="#71717A"/>
                        <TextBlock x:Name="StatusText"
                                   Text="Sin conexión activa"
                                   Foreground="#E4E4E7"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                        <Border x:Name="StatsBadge"
                                Background="#27272A"
                                BorderBrush="#3F3F46"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,2"
                                IsVisible="False"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="StatsText"
                                       Text="0 FPS • 0 KB/s"
                                       Foreground="#38BDF8"
                                       FontSize="11"
                                       FontWeight="Medium"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <ToggleButton x:Name="RemoteControlButton"
                                      Content="🎮 Control"
                                      IsVisible="False"
                                      Background="#27272A"
                                      Foreground="White"
                                      Padding="10,6"
                                      CornerRadius="4"
                                      FontSize="12"
                                      ToolTip.Tip="Habilitar interacción con mouse y teclado"/>

                        <ToggleButton x:Name="GameModeButton"
                                      Content="🎯 Modo 3D (Ctrl+Alt+L)"
                                      IsVisible="False"
                                      Background="#27272A"
                                      Foreground="White"
                                      Padding="10,6"
                                      CornerRadius="4"
                                      FontSize="12"
                                      ToolTip.Tip="Captura el mouse para juegos 3D (giro 360°). Presiona Ctrl+Alt+L para liberar el cursor"/>

                        <Button x:Name="AudioMuteButton"
                                Content="🔊"
                                IsVisible="False"
                                Background="#27272A"
                                Foreground="White"
                                Padding="10,6"
                                CornerRadius="4"
                                FontSize="13"
                                ToolTip.Tip="Silenciar / Activar audio"/>

                        <Button x:Name="DisconnectButton"
                                Content="Desconectar"
                                IsVisible="False"
                                Background="#DC2626"
                                Foreground="White"
                                Padding="12,6"
                                CornerRadius="4"
                                FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Stream Viewport -->
            <Grid Grid.Row="1" Background="#09090B">
                <!-- Video Image -->
                <Image x:Name="ScreenImage"
                       Stretch="Uniform"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       Focusable="True"/>

                <!-- Game 3D Mode Floating Notification -->
                <Border x:Name="GameModeBanner"
                        Background="#E618181B"
                        BorderBrush="#38BDF8"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,7"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,14,0,0"
                        IsVisible="False"
                        IsHitTestVisible="False">
                    <TextBlock x:Name="GameModeBannerText"
                               Text="🎯 Modo Juego 3D Activo — Presiona Ctrl + Alt + L para liberar el mouse"
                               Foreground="#38BDF8"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                </Border>

                <!-- Placeholder Overlay -->
                <StackPanel x:Name="PlaceholderPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12"
                            MaxWidth="400">
                    <Border Width="64" Height="64" CornerRadius="32" Background="#27272A" HorizontalAlignment="Center">
                        <TextBlock Text="📺" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Área de Transmisión"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#FAFAFA"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Haz clic en 'Transmitir mi pantalla' para compartir con otros equipos, o presiona 'Ver' en un dispositivo detectado para ver su pantalla en tiempo real."
                               FontSize="13"
                               Foreground="#71717A"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
