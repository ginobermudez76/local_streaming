<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:LanScreenShare.Core.Models"
        mc:Ignorable="d" d:DesignWidth="1050" d:DesignHeight="650"
        x:Class="LanScreenShare.Desktop.MainWindow"
        Title="LanScreenShare - Streaming LAN"
        Width="1050" Height="650"
        MinWidth="800" MinHeight="500"
        Background="#18181B">

    <Grid ColumnDefinitions="280,*">
        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#1F1F23" BorderBrush="#2D2D35" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="16">
                <!-- App Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="4">
                    <TextBlock Text="LanScreenShare" FontSize="20" FontWeight="Bold" Foreground="#FAFAFA"/>
                    <TextBlock Text="Transmisión de pantalla en LAN" FontSize="12" Foreground="#A1A1AA"/>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,16">
                    <Button x:Name="HostButton"
                            Content="Transmitir mi pantalla"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="#3B82F6"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Padding="12,10"
                            CornerRadius="6"/>

                    <Button x:Name="SearchButton"
                            Content="Buscar dispositivos"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="#27272A"
                            Foreground="White"
                            Padding="12,10"
                            CornerRadius="6"/>
                </StackPanel>

                <!-- Devices Header -->
                <TextBlock Grid.Row="2"
                           Text="Dispositivos detectados:"
                           Foreground="#A1A1AA"
                           FontSize="12"
                           FontWeight="Medium"
                           Margin="0,0,0,8"/>

                <!-- Devices List -->
                <ListBox Grid.Row="3"
                         x:Name="DevicesList"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:DeviceInfo">
                            <Border Background="#27272A"
                                    BorderBrush="#3F3F46"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="0,0,0,6">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#FAFAFA"/>
                                        <TextBlock Text="{Binding IPAddress}" FontSize="12" Foreground="#71717A"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Ver"
                                            Tag="{Binding}"
                                            Click="ConnectDevice_Click"
                                            Background="#2563EB"
                                            Foreground="White"
                                            FontSize="12"
                                            Padding="10,6"
                                            CornerRadius="4"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Footer / Local Info -->
                <TextBlock Grid.Row="4"
                           x:Name="LocalInfoText"
                           Text="Listo para transmitir o recibir"
                           FontSize="11"
                           Foreground="#71717A"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- Main Area (Stream Preview) -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <!-- Stream Header Bar -->
            <Border Grid.Row="0"
                    Background="#1F1F23"
                    BorderBrush="#2D2D35"
                    BorderThickness="0,0,0,1"
                    Padding="16,10">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusIndicator" Width="10" Height="10" Fill="#71717A"/>
                        <TextBlock x:Name="StatusText"
                                   Text="Sin conexión activa"
                                   Foreground="#E4E4E7"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            x:Name="DisconnectButton"
                            Content="Desconectar"
                            IsVisible="False"
                            Background="#DC2626"
                            Foreground="White"
                            Padding="12,6"
                            CornerRadius="4"
                            FontSize="12"/>
                </Grid>
            </Border>

            <!-- Stream Viewport -->
            <Grid Grid.Row="1" Background="#09090B">
                <!-- Video Image -->
                <Image x:Name="ScreenImage"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

                <!-- Placeholder Overlay -->
                <StackPanel x:Name="PlaceholderPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12"
                            MaxWidth="400">
                    <Border Width="64" Height="64" CornerRadius="32" Background="#27272A" HorizontalAlignment="Center">
                        <TextBlock Text="📺" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Área de Transmisión"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#FAFAFA"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Haz clic en 'Transmitir mi pantalla' para compartir con otros equipos, o presiona 'Ver' en un dispositivo detectado para ver su pantalla en tiempo real."
                               FontSize="13"
                               Foreground="#71717A"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
