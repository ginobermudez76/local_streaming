<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:LanScreenShare.Core.Models"
        mc:Ignorable="d" d:DesignWidth="1050" d:DesignHeight="650"
        x:Class="LanScreenShare.Desktop.MainWindow"
        Title="LanScreenShare - Streaming LAN"
        Width="1050" Height="650"
        MinWidth="800" MinHeight="500"
        Background="#18181B">

    <Grid x:Name="RootGrid" ColumnDefinitions="310,*">
        <!-- Sidebar -->
        <Border x:Name="SidebarBorder" Grid.Column="0" Background="#1F1F23" BorderBrush="#2D2D35" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="16">
                    <!-- App Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,14" Spacing="4">
                    <TextBlock Text="LanScreenShare" FontSize="20" FontWeight="Bold" Foreground="#FAFAFA"/>
                    <TextBlock Text="Transmisión de pantalla en LAN" FontSize="12" Foreground="#A1A1AA"/>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,14">
                    <Button x:Name="HostButton"
                            Content="Transmitir mi pantalla"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="#3B82F6"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Padding="12,10"
                            CornerRadius="6"/>

                    <Button x:Name="SearchButton"
                            Content="Buscar dispositivos"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="#27272A"
                            Foreground="White"
                            Padding="12,10"
                            CornerRadius="6"/>
                </StackPanel>

                <!-- Settings Section -->
                <Border Grid.Row="2"
                        Background="#27272A"
                        BorderBrush="#3F3F46"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Ajustes de Transmisión"
                                   Foreground="#FAFAFA"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>

                        <!-- Source Selector -->
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Fuente a Transmitir" FontSize="11" Foreground="#A1A1AA"/>
                                <TextBlock Grid.Column="1" x:Name="SourceTypeBadge" Text="Pantalla" FontSize="10" Foreground="#38BDF8" FontWeight="Medium"/>
                            </Grid>
                            <Button x:Name="SelectSourceButton"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Background="#27272A"
                                    BorderBrush="#3F3F46"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,8"
                                    Cursor="Hand">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <PathIcon Grid.Column="0"
                                              x:Name="SourceIcon"
                                              Data="{StaticResource IconTv}"
                                              Width="16" Height="16"
                                              Foreground="#38BDF8"
                                              Margin="0,0,8,0"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               x:Name="SelectedSourceNameText"
                                               Text="Pantalla 1"
                                               FontSize="12"
                                               Foreground="#F4F4F5"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2"
                                               Text="Cambiar ▾"
                                               FontSize="11"
                                               Foreground="#93C5FD"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0"/>
                                </Grid>
                            </Button>
                        </StackPanel>

                        <!-- Engine Selector -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Motor de Captura" FontSize="11" Foreground="#A1A1AA"/>
                            <ComboBox x:Name="EngineComboBox"
                                      HorizontalAlignment="Stretch"
                                      FontSize="12"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="DirectX DXGI (GPU Acelerado)" Tag="dxgi"/>
                                <ComboBoxItem Content="GDI BitBlt (CPU Compatibilidad)" Tag="gdi"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Codec Selector -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Códec de Video" FontSize="11" Foreground="#A1A1AA"/>
                            <ComboBox x:Name="CodecComboBox"
                                      HorizontalAlignment="Stretch"
                                      FontSize="12"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="JPEG (Ultra Baja Latencia / Estable)" Tag="jpeg"/>
                                <ComboBoxItem Content="H.264 / AVC (Media Foundation)" Tag="h264"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- FPS Selector -->
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="FPS Objetivo" FontSize="11" Foreground="#A1A1AA"/>
                                <TextBlock Grid.Column="1" x:Name="FpsValueLabel" Text="30 FPS" FontSize="11" Foreground="#38BDF8" FontWeight="Medium"/>
                            </Grid>
                            <ComboBox x:Name="FpsComboBox"
                                      HorizontalAlignment="Stretch"
                                      FontSize="12"
                                      SelectedIndex="1">
                                <ComboBoxItem Content="15 FPS (Bajo consumo)" Tag="15"/>
                                <ComboBoxItem Content="30 FPS (Recomendado)" Tag="30"/>
                                <ComboBoxItem Content="60 FPS (Ultra fluido)" Tag="60"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Quality Slider -->
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" x:Name="QualityTitleLabel" Text="Calidad JPEG" FontSize="11" Foreground="#A1A1AA"/>
                                <TextBlock Grid.Column="1" x:Name="QualityValueLabel" Text="75%" FontSize="11" Foreground="#38BDF8" FontWeight="Medium"/>
                            </Grid>
                            <Slider x:Name="QualitySlider"
                                    Minimum="30"
                                    Maximum="95"
                                    Value="75"
                                    SmallChange="5"
                                    LargeChange="10"/>
                        </StackPanel>

                        <!-- Resolution Scale Selector -->
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Resolución" FontSize="11" Foreground="#A1A1AA"/>
                                <TextBlock Grid.Column="1" x:Name="ScaleValueLabel" Text="Nativa" FontSize="11" Foreground="#38BDF8" FontWeight="Medium"/>
                            </Grid>
                            <ComboBox x:Name="ScaleComboBox"
                                      HorizontalAlignment="Stretch"
                                      FontSize="12"
                                      SelectedIndex="0"/>
                        </StackPanel>

                        <!-- Audio Share Toggle -->
                        <CheckBox x:Name="AudioShareCheckBox"
                                  Content="Transmitir audio del sistema (Loopback)"
                                  IsChecked="True"
                                  Foreground="#E4E4E7"
                                  FontSize="11"
                                  Margin="0,2,0,0"/>

                        <!-- Microphone Share Toggle -->
                        <CheckBox x:Name="MicShareCheckBox"
                                  Content="Transmitir micrófono del anfitrión"
                                  IsChecked="False"
                                  Foreground="#E4E4E7"
                                  FontSize="11"
                                  Margin="0,2,0,0"/>

                        <!-- Remote Control Allow Toggle -->
                        <CheckBox x:Name="AllowRemoteControlCheckBox"
                                  Content="Permitir control remoto (Mouse/Teclas)"
                                  IsChecked="True"
                                  Foreground="#E4E4E7"
                                  FontSize="11"
                                  Margin="0,2,0,0"/>

                        <!-- Stream Access Approval Mode -->
                        <StackPanel Spacing="3" Margin="0,4,0,0">
                            <TextBlock Text="Acceso a la Transmisión" FontSize="11" Foreground="#A1A1AA"/>
                            <ComboBox x:Name="StreamAccessModeComboBox"
                                      HorizontalAlignment="Stretch"
                                      FontSize="11"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="Cualquiera en LAN (Automático)" Tag="auto"/>
                                <ComboBoxItem Content="Solicitar aprobación de espectadores" Tag="ask"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Remote Control Access Mode -->
                        <StackPanel x:Name="ControlAccessModePanel" Spacing="3" Margin="0,2,0,0" IsVisible="False">
                            <TextBlock Text="Aprobación de Control Remoto" FontSize="11" Foreground="#A1A1AA"/>
                            <ComboBox x:Name="ControlAccessModeComboBox"
                                      HorizontalAlignment="Stretch"
                                      FontSize="11"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="Cualquiera con permiso (Automático)" Tag="auto"/>
                                <ComboBoxItem Content="Solicitar aprobación antes de interactuar" Tag="ask"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Admin Privilege Warning/Badge -->
                        <Border x:Name="AdminStatusBorder"
                                Background="#27272A"
                                CornerRadius="4"
                                Padding="8,5"
                                Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <PathIcon x:Name="AdminStatusIcon" Data="{StaticResource IconShield}" Width="12" Height="12" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                <TextBlock x:Name="AdminStatusText"
                                           Text="Modo Estándar"
                                           Foreground="#F59E0B"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Devices Header -->
                <TextBlock Grid.Row="3"
                           Text="Dispositivos detectados:"
                           Foreground="#A1A1AA"
                           FontSize="12"
                           FontWeight="Medium"
                           Margin="0,0,0,8"/>

                <!-- Devices List -->
                <ListBox Grid.Row="4"
                         x:Name="DevicesList"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:DeviceInfo">
                            <Border Background="#27272A"
                                    BorderBrush="#3F3F46"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="0,0,0,6">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#FAFAFA"/>
                                        <TextBlock Text="{Binding IPAddress}" FontSize="12" Foreground="#71717A"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Ver"
                                            Tag="{Binding}"
                                            Click="ConnectDevice_Click"
                                            Background="#2563EB"
                                            Foreground="White"
                                            FontSize="12"
                                            Padding="10,6"
                                            CornerRadius="4"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Footer / Local Info -->
                <TextBlock Grid.Row="5"
                           x:Name="LocalInfoText"
                           Text="Listo para transmitir o recibir"
                           FontSize="11"
                           Foreground="#71717A"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"/>
            </Grid>
        </ScrollViewer>
    </Border>

        <!-- Main Area (Stream Preview) -->
        <Grid Grid.Column="1" x:Name="MainAreaGrid" RowDefinitions="Auto,*">
            <!-- Stream Header Bar -->
            <Border x:Name="StreamHeaderBar"
                    Grid.Row="0"
                    Background="#1F1F23"
                    BorderBrush="#2D2D35"
                    BorderThickness="0,0,0,1"
                    Padding="16,10">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusIndicator" Width="10" Height="10" Fill="#71717A"/>
                        <TextBlock x:Name="StatusText"
                                   Text="Sin conexión activa"
                                   Foreground="#E4E4E7"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                        <Border x:Name="StatsBadge"
                                Background="#27272A"
                                BorderBrush="#3F3F46"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,2"
                                IsVisible="False"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="StatsText"
                                       Text="0 FPS • 0 KB/s"
                                       Foreground="#38BDF8"
                                       FontSize="11"
                                       FontWeight="Medium"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <ToggleButton x:Name="RemoteControlButton"
                                      IsVisible="False"
                                      Background="#27272A"
                                      Foreground="White"
                                      Padding="10,6"
                                      CornerRadius="4"
                                      ToolTip.Tip="Habilitar interacción con mouse y teclado">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource IconGamepad}" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Text="Control" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton x:Name="GameModeButton"
                                      IsVisible="False"
                                      Background="#27272A"
                                      Foreground="White"
                                      Padding="10,6"
                                      CornerRadius="4"
                                      ToolTip.Tip="Captura el mouse para juegos 3D (giro 360°). Presiona Ctrl+Alt+L para liberar el cursor">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource Icon3dRotation}" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Text="Modo 3D (Ctrl+Alt+L)" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>

                        <!-- Audio Control (Mute & Volume Slider) -->
                        <Border x:Name="AudioControlPanel"
                                IsVisible="False"
                                Background="#27272A"
                                CornerRadius="4"
                                Padding="4,2">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button x:Name="AudioMuteButton"
                                        Background="Transparent"
                                        Foreground="White"
                                        Padding="4"
                                        BorderThickness="0"
                                        ToolTip.Tip="Silenciar / Activar audio del sistema">
                                    <PathIcon x:Name="AudioMuteIcon" Data="{StaticResource IconVolumeUp}" Width="14" Height="14" Foreground="White"/>
                                </Button>
                                <Slider x:Name="AudioVolumeSlider"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="100"
                                        Width="65"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="Volumen de audio del sistema / juego"/>
                                <TextBlock x:Name="AudioVolumeText"
                                           Text="100%"
                                           FontSize="11"
                                           Foreground="#A1A1AA"
                                           VerticalAlignment="Center"
                                           Margin="0,0,4,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Microphone Control (Mute & Volume Slider) -->
                        <Border x:Name="MicControlPanel"
                                IsVisible="False"
                                Background="#27272A"
                                CornerRadius="4"
                                Padding="4,2">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button x:Name="MicMuteButton"
                                        Background="Transparent"
                                        Foreground="White"
                                        Padding="4"
                                        BorderThickness="0"
                                        ToolTip.Tip="Silenciar / Activar micrófono del anfitrión">
                                    <PathIcon x:Name="MicMuteIcon" Data="{StaticResource IconMic}" Width="14" Height="14" Foreground="#10B981"/>
                                </Button>
                                <Slider x:Name="MicVolumeSlider"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="100"
                                        Width="65"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="Volumen del micrófono del anfitrión"/>
                                <TextBlock x:Name="MicVolumeText"
                                           Text="100%"
                                           FontSize="11"
                                           Foreground="#A1A1AA"
                                           VerticalAlignment="Center"
                                           Margin="0,0,4,0"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="StretchModeButton"
                                IsVisible="False"
                                Background="#27272A"
                                Foreground="White"
                                Padding="10,6"
                                CornerRadius="4"
                                ToolTip.Tip="Alternar modo de ajuste: Ajustar aspecto (Fit) / Llenar pantalla (Stretch)">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource IconAspectRatio}" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StretchModeButtonText" Text="Ajustar" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="PopoutWindowButton"
                                IsVisible="False"
                                Background="#27272A"
                                Foreground="White"
                                Padding="8,6"
                                CornerRadius="4"
                                ToolTip.Tip="Abrir transmisión en ventana emergente independiente">
                            <PathIcon Data="{StaticResource IconOpenInNew}" Width="14" Height="14" Foreground="White"/>
                        </Button>

                        <Button x:Name="FullscreenButton"
                                IsVisible="False"
                                Background="#27272A"
                                Foreground="White"
                                Padding="10,6"
                                CornerRadius="4"
                                ToolTip.Tip="Alternar Pantalla Completa (F11 / Doble Clic)">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <PathIcon x:Name="FullscreenButtonIcon" Data="{StaticResource IconFullscreen}" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock x:Name="FullscreenButtonText" Text="Pantalla Completa" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="DisconnectButton"
                                Content="Desconectar"
                                IsVisible="False"
                                Background="#DC2626"
                                Foreground="White"
                                Padding="12,6"
                                CornerRadius="4"
                                FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Stream Viewport -->
            <Grid x:Name="StreamViewportGrid" Grid.Row="1" Background="#09090B">
                <!-- Video Image -->
                <Image x:Name="ScreenImage"
                       Stretch="Uniform"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       Focusable="True"
                       RenderOptions.BitmapInterpolationMode="HighQuality"/>

                <!-- Popout Mode Active Placeholder -->
                <StackPanel x:Name="PopoutActivePanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="14"
                            IsVisible="False">
                    <PathIcon Data="{StaticResource IconOpenInNew}" Width="48" Height="48" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                    <TextBlock Text="Transmisión en ventana emergente"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#F4F4F5"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="La pantalla se está reproduciendo en una ventana independiente."
                               FontSize="12"
                               Foreground="#A1A1AA"
                               HorizontalAlignment="Center"/>
                    <Button x:Name="ReattachStreamButton"
                            HorizontalAlignment="Center"
                            Background="#2563EB"
                            Foreground="White"
                            Padding="14,8"
                            CornerRadius="6"
                            FontWeight="Medium">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconDock}" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="Reacoplar a ventana principal" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Floating Exit Fullscreen Button -->
                <Button x:Name="ExitFullscreenFloatButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,14,14,0"
                        Background="#D918181B"
                        Foreground="#38BDF8"
                        BorderBrush="#38BDF8"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,6"
                        IsVisible="False"
                        ZIndex="50">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconFullscreenExit}" Width="12" Height="12" Foreground="#38BDF8" VerticalAlignment="Center"/>
                        <TextBlock Text="Salir (F11 / Esc)" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Host Stream Connection Request Approval Banner -->
                <Border x:Name="StreamApprovalBanner"
                        Background="#F218181B"
                        BorderBrush="#3B82F6"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,14,0,0"
                        IsVisible="False"
                        ZIndex="60">
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconNotifications}" Width="20" Height="20" Foreground="#3B82F6" VerticalAlignment="Center"/>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="StreamApprovalTitle" Text="Solicitud de Visualización de Pantalla" FontWeight="SemiBold" Foreground="White" FontSize="12"/>
                            <TextBlock x:Name="StreamApprovalSubtitle" Text="Un dispositivo solicita conectarse a la transmisión." Foreground="#A1A1AA" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="ApproveStreamButton" Content="Permitir" Background="#22C55E" Foreground="White" FontWeight="SemiBold" Padding="12,6" CornerRadius="4" FontSize="11"/>
                            <Button x:Name="RejectStreamButton" Content="Rechazar" Background="#DC2626" Foreground="White" FontWeight="SemiBold" Padding="12,6" CornerRadius="4" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Host Remote Control Request Approval Banner -->
                <Border x:Name="ControlApprovalBanner"
                        Background="#F218181B"
                        BorderBrush="#F59E0B"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,68,0,0"
                        IsVisible="False"
                        ZIndex="60">
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconGamepad}" Width="20" Height="20" Foreground="#F59E0B" VerticalAlignment="Center"/>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="ControlApprovalTitle" Text="Solicitud de Control Remoto (Mouse y Teclado)" FontWeight="SemiBold" Foreground="White" FontSize="12"/>
                            <TextBlock x:Name="ControlApprovalSubtitle" Text="Un dispositivo solicita controlar tu mouse y teclado." Foreground="#A1A1AA" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="ApproveControlButton" Content="Aprobar" Background="#22C55E" Foreground="White" FontWeight="SemiBold" Padding="12,6" CornerRadius="4" FontSize="11"/>
                            <Button x:Name="RejectControlButton" Content="Rechazar" Background="#DC2626" Foreground="White" FontWeight="SemiBold" Padding="12,6" CornerRadius="4" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Game 3D Mode Floating Notification -->
                <Border x:Name="GameModeBanner"
                        Background="#E618181B"
                        BorderBrush="#38BDF8"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,7"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,14,0,0"
                        IsVisible="False"
                        IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <PathIcon x:Name="GameModeBannerIcon" Data="{StaticResource Icon3dRotation}" Width="14" Height="14" Foreground="#38BDF8" VerticalAlignment="Center"/>
                        <TextBlock x:Name="GameModeBannerText"
                                   Text="Modo Juego 3D Activo — Presiona Ctrl + Alt + L para liberar el mouse"
                                   Foreground="#38BDF8"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Placeholder Overlay -->
                <StackPanel x:Name="PlaceholderPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12"
                            MaxWidth="400">
                    <Border Width="64" Height="64" CornerRadius="32" Background="#27272A" HorizontalAlignment="Center">
                        <PathIcon Data="{StaticResource IconTv}" Width="28" Height="28" Foreground="#A1A1AA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Área de Transmisión"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#FAFAFA"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Haz clic en 'Transmitir mi pantalla' para compartir con otros equipos, o presiona 'Ver' en un dispositivo detectado para ver su pantalla en tiempo real."
                               FontSize="13"
                               Foreground="#71717A"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
